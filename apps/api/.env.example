NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://shango:replace-with-local-password@localhost:54329/shango
REDIS_URL=redis://localhost:63799/0
JWT_SECRET=replace-with-at-least-32-random-characters
OTP_SECRET=replace-with-another-32-random-characters
OTP_PROVIDER=development
# Exact origins only (no wildcard). HTTP is accepted for localhost/127.0.0.1 only.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175
# Web cookie auth (/auth/web/*, ADR-002). Off by default; legacy Expo auth is unaffected.
WEB_AUTH_ENABLED=false
# Required when WEB_AUTH_ENABLED=true: at least 32 random characters, different from JWT/OTP secrets.
# CSRF_SECRET=replace-with-a-third-32-random-characters
# Geocoding and routing are disabled until explicitly configured.
# Local self-hosted examples:
# NOMINATIM_BASE_URL=http://127.0.0.1:8088
# OSRM_BASE_URL=http://127.0.0.1:5000
# For manual development search only, optionally enable the public geocoder:
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_PUBLIC_OPT_IN=false
NOMINATIM_USER_AGENT=ShanGo/0.1 (+https://github.com/ShanChen6/Shango)
# Private directory, never serve it as a static/public directory.
PRIVATE_DOCUMENTS_DIR=.private-documents
DRIVER_REQUIRED_DOCUMENTS=identity_front,identity_back,driver_license,vehicle_registration

# WEB-009 orders/dispatch pilot gate (off by default). Needs OSRM_BASE_URL for quotes.
ORDERS_ENABLED=false
# Pilot tariff in integer VND, NOT PO-approved pricing. A vehicle type without both values cannot be quoted.
TARIFF_VERSION=pilot-unapproved
# TARIFF_MOTORCYCLE_BASE_VND=15000
# TARIFF_MOTORCYCLE_PER_KM_VND=5000
# TARIFF_CAR_BASE_VND=
# TARIFF_CAR_PER_KM_VND=
DISPATCH_RADIUS_M=5000
DISPATCH_OFFER_SECONDS=20
DISPATCH_SEARCH_SECONDS=300
DISPATCH_TICK_MS=2000
# PostgreSQL connections per API process.
DB_POOL_MAX=10
