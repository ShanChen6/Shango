NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://shango:replace-with-local-password@localhost:54329/shango
REDIS_URL=redis://localhost:63799/0
JWT_SECRET=replace-with-at-least-32-random-characters
OTP_SECRET=replace-with-another-32-random-characters
OTP_PROVIDER=development
CORS_ORIGINS=http://localhost:5173
# Geocoding and routing are disabled until explicitly configured.
# Local self-hosted examples:
# NOMINATIM_BASE_URL=http://127.0.0.1:8088
# OSRM_BASE_URL=http://127.0.0.1:5000
# For manual development search only, optionally enable the public geocoder:
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_PUBLIC_OPT_IN=false
NOMINATIM_USER_AGENT=ShanGo/0.1 (+https://github.com/ShanChen6/Shango)
# Private directory, never serve it as a static/public directory.
PRIVATE_DOCUMENTS_DIR=.private-documents
DRIVER_REQUIRED_DOCUMENTS=identity_front,identity_back,driver_license,vehicle_registration
