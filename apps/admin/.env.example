VITE_API_URL=http://localhost:3000/api/v1
# Web cookie auth canary (needs API WEB_AUTH_ENABLED=true). Remove VITE_API_URL above so the
# app uses the same-site /api proxy; a cross-site API URL drops the SameSite=Lax refresh cookie.
# VITE_WEB_AUTH_ENABLED=true
# Configure an authorized tile source and required provider attribution together.
# No external tiles are loaded when these are unset.
# VITE_MAP_TILE_URL=https://your-tile-provider/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=Your tile provider attribution
