# Copy to deploy/staging.env (gitignored) and fill in. Never commit real values.
IMAGE_TAG=replace-with-git-sha
REGISTRY=shango
CUSTOMER_HOST=customer.staging.example.vn
DRIVER_HOST=driver.staging.example.vn
ADMIN_HOST=admin.staging.example.vn
# Space-separated networks allowed to reach staging (office/VPN). Do not use 0.0.0.0/0.
STAGING_ALLOWED_CIDRS=203.0.113.0/24
# Caddy global options: ACME contact for public certificates.
CADDY_GLOBAL_OPTIONS=email ops@example.vn
# Generate each with: openssl rand -base64 48
POSTGRES_PASSWORD=
JWT_SECRET=
OTP_SECRET=
CSRF_SECRET=
METRICS_TOKEN=
# Comma-separated E.164 phones of testers (development OTP is shown to the caller).
OTP_DEV_PHONE_ALLOWLIST=+84900000001
ORDERS_ENABLED=false
OSRM_BASE_URL=
NOMINATIM_BASE_URL=
TARIFF_VERSION=pilot-unapproved
TARIFF_MOTORCYCLE_BASE_VND=
TARIFF_MOTORCYCLE_PER_KM_VND=
MAP_TILE_ORIGIN=
# ORIGIN_PORT_SUFFIX=:8443  # only if HTTPS is not served on 443
